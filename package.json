{
  "name": "hype-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "dev": "node build.mjs && HYPE_DISC=${HYPE_DISC:-} node serve.mjs",
    "headless": "node build.mjs && node dist/node-run.mjs",
    "release": "node build.mjs --minify"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "esbuild": "^0.28.2",
    "playwright-core": "^1.64.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
